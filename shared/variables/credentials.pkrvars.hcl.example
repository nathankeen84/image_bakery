# Azure Service Principal Credentials for Packer
# IMPORTANT: DO NOT COMMIT credentials.pkrvars.hcl to version control!
# This is a template. Copy to credentials.pkrvars.hcl and fill in your values.
# Then use: packer build -var-file=credentials.pkrvars.hcl ...

# Azure Service Principal (required for Packer builds)
# Create SP: az ad sp create-for-rbac --name ImageBakery-Packer --role Contributor
client_id       = "YOUR_CLIENT_ID"
client_secret   = "YOUR_CLIENT_SECRET"
tenant_id       = "YOUR_TENANT_ID"

# Optional: Baseline Agent Credentials (if not using Key Vault)
# These are best retrieved from Azure Key Vault instead of hardcoding here
qualys_api_key        = ""
qualys_api_url        = ""
nxlog_api_key         = ""
nxlog_endpoint        = ""
xm_cyber_api_key      = ""
xm_cyber_api_url      = ""
newrelic_license_key  = ""
