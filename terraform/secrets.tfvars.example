# Image Bakery Secrets Configuration
# 
# SECURITY WARNING: This file contains sensitive information
# 
# Instructions:
# 1. Copy this file to: terraform/secrets.tfvars
# 2. Fill in your actual secret values
# 3. NEVER commit secrets.tfvars to git
# 4. Add to .gitignore: terraform/secrets.tfvars
# 5. Use in Terraform: terraform apply -var-file=terraform.tfvars -var-file=secrets.tfvars

# Packer Service Principal Credentials
# Create via: az ad sp create-for-rbac --name "ImageBakery-Packer"
packer_client_id       = "YOUR_PACKER_CLIENT_ID"
packer_client_secret   = "YOUR_PACKER_CLIENT_SECRET"
packer_tenant_id       = "YOUR_TENANT_ID"
packer_subscription_id = "YOUR_SUBSCRIPTION_ID"

# Qualys Agent Configuration
# Get credentials from: https://qualysapi.qg2.apps.qualys.com/
qualys_api_key  = "YOUR_QUALYS_API_KEY"
qualys_api_url  = "https://qualysapi.qg2.apps.qualys.com"
qualys_username = "YOUR_QUALYS_USERNAME"
qualys_password = "YOUR_QUALYS_PASSWORD"

# NXLog Agent Configuration
# Get from your NXLog account or deployment system
nxlog_api_key = "YOUR_NXLOG_API_KEY"
nxlog_endpoint = "https://your-nxlog-collector.example.com:5514"

# XM Cyber Agent Configuration
# Get from: https://www.xm-cyber.com/
xm_cyber_api_key = "YOUR_XM_CYBER_API_KEY"
xm_cyber_api_url = "https://api.xm-cyber.com"

# New Relic Agent Configuration
# Get from: https://one.newrelic.com/
newrelic_api_key      = "YOUR_NEWRELIC_API_KEY"
newrelic_license_key  = "YOUR_NEWRELIC_LICENSE_KEY"

# Optional: Certificate path for TLS
enable_certificate_secret = false
certificate_path          = ""
